// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  directUrl         = env("DIRECT_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  email     String   @unique
  role      String
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isActive  Boolean   @default(true)
  deletedAt DateTime?

  // Relations
  absences       Absence[]
  vacations      TotalVacationDays[]
  workHours      WorkHours[]
  SidebarProject SidebarProject[]
  notifications       Notifications[]
  submissions         TimeSheetSubmission[]
  approvedSubmissions TimeSheetSubmission[] @relation("Approver")
}


model Holidays {
  id   Int    @id @default(autoincrement())
  date String

  holiday String

  @@unique([date])
  @@index([date])
}
model Company {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  projects        Projects[]
  sidebarProjects SidebarProject[]

  @@index([isActive])
}

model Projects {
  id        Int      @id @default(autoincrement())
  companyId Int
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  workHours WorkHours[]

  @@unique([companyId, project])
  @@index([isActive])
  @@index([companyId])
}

enum AbsenceType {
  VACATION
  SICK
  PERSONAL
  PARENTAL
}

model Absence {
  id        String      @id @default(uuid())
  startDate DateTime    @db.Date
  endDate   DateTime    @db.Date
  type      AbsenceType
  days      Int         // Business days calculated at creation

  userId Int
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, startDate, endDate])
  @@index([userId, type])
  @@index([startDate, endDate, type])
}

model TotalVacationDays {
  id          Int       @id @default(autoincrement())
  year        Int
  grantedDays Int
  usedDays    Int @default(0)

  userId      Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, year])
  @@index([userId, year])
  @@index([year])
}

model WorkHours {
  id    Int @id @default(autoincrement())
  date  DateTime
  hours Float
  note  String?

  userId Int
  user  User @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectId Int
  project   Projects @relation(fields: [projectId], references: [id], onDelete: Restrict)

  submissionId Int?
  submission   TimeSheetSubmission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)

  @@unique([userId, date, projectId])
  @@index([date, userId])
  @@index([submissionId])
}

model SidebarProject {
  id         String  @id @default(cuid())
  userId     Int
  companyId  Int
  company    Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  title      String
  projectKey String
  month      Int
  year       Int

  user User @relation(fields: [userId], references: [id])

  @@index([userId, month, year])
  @@index([companyId])
}

model Notifications {
  id           String           @id @default(cuid())
  userId       Int
  senderUserId Int?
  title        String
  message      String           @db.Text
  type         NotificationType
  isRead       Boolean          @default(false)
  actionType   String?
  actionUrl    String?
  actionData   Json?
  actionMonth  Int?
  actionYear   Int?
  createdAt    DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@index([senderUserId])
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ACTION_REQUIRED
  APPROVAL_REQUEST
}

model TimeSheetSubmission {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Canonical key for a submission period (prevents timezone-based duplicates)
  periodYear  Int
  periodMonth Int

  periodStart DateTime
  periodEnd   DateTime

  status SubmissionStatus @default(DRAFT)

  submittedAt DateTime?
  approvedAt  DateTime?
  rejectedAt  DateTime?

  approverId Int?
  approver   User? @relation("Approver", fields: [approverId], references: [id], onDelete: SetNull)

  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workHours WorkHours[]

  @@unique([userId, periodStart, periodEnd])
  @@unique([userId, periodYear, periodMonth])
  @@index([userId, periodYear, periodMonth])
  @@index([userId, status])
  @@index([status, periodStart])
}

enum SubmissionStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  LOCKED
}